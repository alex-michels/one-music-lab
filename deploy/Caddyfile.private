{
	admin off
	persist_config off
	auto_https off
}

# Separate unprivileged instance. Never import this into the shared Caddy service.
http://:8098 {
	bind 127.0.0.1
	root * {$OML_STATIC_ROOT:/nonexistent/one-music-lab-private}
	@foreign not host 127.0.0.1
	respond @foreign 421
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
	}
	file_server {
		hide .git .env .vite *.map
	}
}
